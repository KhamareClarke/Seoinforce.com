# --- Public URL (used for metadata, canonical, emails, Stripe return URLs) ---
NEXT_PUBLIC_APP_URL=https://seoinforce.com

# Optional: JSON-LD / brand socials (full URLs)
# NEXT_PUBLIC_SOCIAL_TWITTER=https://twitter.com/seoinforce
# NEXT_PUBLIC_SOCIAL_LINKEDIN=
# NEXT_PUBLIC_SOCIAL_GITHUB=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP (same pattern as FlipRepublic: SMTP_* preferred; EMAIL_* supported) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# SMTP_FROM="SEOInForce <hello@yourdomain.com>"
# Or legacy:
# EMAIL_USER=
# EMAIL_PASS=

# Internal notification inboxes (audit / booking forms)
AUDIT_EMAIL=
BOOKING_EMAIL=
# ADMIN_EMAIL=   # fallback if AUDIT_EMAIL / BOOKING_EMAIL omitted

# --- Go High Level (same keys as myapproved.com — Private Integration pit-... token) ---
# GHL_API_KEY=          # or GOHIGHLEVEL_API_KEY / GOHIGHLEVEL_SMS_API_KEY
# GHL_LOCATION_ID=      # or GOHIGHLEVEL_LOCATION_ID / GOHIGHLEVEL_SMS_LOCATION_ID
# GHL_API_VERSION=2021-07-28
# GHL_DEBUG_SMS=1       # log delivery poll attempts (myapproved pattern)

# Server-to-server SMS trigger auth. Header: x-seoinforce-internal: <same value>
# GHL_NOTIFICATION_SECRET=

# --- Go High Level: workflow webhooks (Task 1.3 — Inbound Webhook in GHL per automation) ---
# Optional shared secret: header x-seoinforce-workflow-secret
# GHL_WORKFLOW_WEBHOOK_SECRET=
# Per-workflow URLs (preferred), or set only GHL_WORKFLOW_WEBHOOK_URL and branch on `event` in GHL:
# GHL_WEBHOOK_AUDIT_COMPLETED_URL=   # Workflow 1: audit completed
# GHL_WEBHOOK_SIGNUP_URL=              # Workflow 3: new user signup
# GHL_WEBHOOK_RANK_CHANGE_URL=       # fallback for rank workflows
# GHL_WEBHOOK_RANK_DROP_URL=         # Workflow 2a: rank dropped
# GHL_WEBHOOK_RANK_GAIN_URL=         # Workflow 2b: rank improved
# GHL_WEBHOOK_SUBSCRIPTION_URL=          # fallback if per-type URLs not set
# GHL_WEBHOOK_SUBSCRIPTION_UPGRADED_URL=   # use when GHL has no conditional Split (3 workflows)
# GHL_WEBHOOK_SUBSCRIPTION_DOWNGRADED_URL=
# GHL_WEBHOOK_SUBSCRIPTION_RENEWED_URL=
# GHL_WEBHOOK_SUBSCRIPTION_CANCELED_URL= # optional; falls back to DOWNGRADED then SUBSCRIPTION_URL
# GHL_WEBHOOK_COMPETITOR_URL=     # Workflow 5: competitor movement
# GHL_WORKFLOW_WEBHOOK_URL=

# Admin dashboard: estimated monthly GHL API quota (for usage % display)
# GHL_API_MONTHLY_QUOTA=50000

# Optional: verify GHL → your app webhooks (delivery updates). POST /api/webhooks/ghl
# Send header: x-ghl-webhook-secret: <same value>
# GHL_WEBHOOK_SECRET=

# Optional: GHL contact custom field IDs (from GHL Settings → Custom Fields)
# GHL_CUSTOM_FIELD_LAST_ACTIVE_ID=
# GHL_CUSTOM_FIELD_PLAN_TYPE_ID=
# GHL_CUSTOM_FIELD_AUDIT_COUNT_ID=
# GHL_CUSTOM_FIELD_USER_ROLE_ID=
# GHL_CUSTOM_FIELD_COMPANY_ID=

# --- Go High Level: Inbound Webhook (marketing / workflows — optional) ---
# GHL_INBOUND_WEBHOOK_URL=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Keyword / SEO data APIs (optional) ---
# SCRAPEOPS_API_KEY=
# SERPAPI_KEY=
# GOOGLE_PAGESPEED_API_KEY=

# --- AI Visibility (optional) ---
# When set, the AI Visibility checker queries Claude to simulate AI search responses.
# Without this key it falls back to heuristic signal analysis (still useful).
# ANTHROPIC_API_KEY=

# --- Cron / jobs (if used) ---
# CRON_SECRET=                        # POST /api/cron/rank-alerts (Authorization: Bearer <secret>)
